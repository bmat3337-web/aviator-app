{
  "compilerOptions":{
    "target":"ES2022",
    "module":"ESNext",
    "moduleResolution":"Bundler",
    "strict":true,
    "noUncheckedIndexedAccess":false,
    "exactOptionalPropertyTypes":false,
    "skipLibCheck":true,
    "forceConsistentCasingInFileNames":true
  },
  "include":["src","tests"]
}